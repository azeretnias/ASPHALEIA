{
  "version": 2,
  "functions": {
    "api/app.py": {
      "runtime": "python3.12",
      "memory": 1024,
      "maxDuration": 30,
      "maxSize": 50
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/app.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}