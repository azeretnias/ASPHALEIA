rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Guardians can read/write their guardianChildren list
    match /guardianChildren/{guardianId} {
      allow read, write: if request.auth != null && request.auth.uid == guardianId;
    }

    // Students can write their own verification events.
    // Guardians can read verification events for children they are linked to.
    match /verifications/{verificationId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.childUid;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.childUid ||
        exists(/databases/$(database)/documents/guardianChildren/$(request.auth.uid)) &&
          resource.data.childUid in get(/databases/$(database)/documents/guardianChildren/$(request.auth.uid)).data.children
      );
      allow update, delete: if false;
    }

    // Location writes are allowed for the student themself.
    match /locations/{locationId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update, delete: if false;
    }
  }
}
